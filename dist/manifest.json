{
  "manifest_version": 3,
  "name": "Sona",
  "version": "0.4.0",
  "description": "Removes background noise from the agent microphone during browser calls.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sona microphone noise cancellation"
  },
  "content_scripts": [
    {
      "matches": [
        "https://52.49.51.30/*",
        "https://*.freshdesk.com/*",
        "https://ec2-52-49-51-30.eu-west-1.compute.amazonaws.com/*",
        "https://*.freshcaller.com/*",
        "https://*.freshworks.com/*",
        "https://meet.google.com/*"
      ],
      "js": ["noise-voice-filter.js", "noise-suppression.js", "xcally-popup-closer.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://52.49.51.30/*",
        "https://*.freshdesk.com/*",
        "https://ec2-52-49-51-30.eu-west-1.compute.amazonaws.com/*",
        "https://*.freshcaller.com/*",
        "https://*.freshworks.com/*",
        "https://meet.google.com/*"
      ],
      "js": ["noise-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/rnnoise/*.wasm", "vendor/rnnoise/rnnoiseWorkletProcessor.js"],
      "matches": [
        "https://52.49.51.30/*",
        "https://*.freshdesk.com/*",
        "https://ec2-52-49-51-30.eu-west-1.compute.amazonaws.com/*",
        "https://*.freshcaller.com/*",
        "https://*.freshworks.com/*",
        "https://meet.google.com/*"
      ]
    }
  ]
}
